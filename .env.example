# FLOWSTATE server configuration (all optional)
PORT=3000
# HOST defaults to 127.0.0.1 locally and 0.0.0.0 when PORT is set (hosting platforms)
# HOST=0.0.0.0
# Session data lives in memory only. Inactive sessions are deleted after this many minutes.
FLOWSTATE_SESSION_TTL_MIN=30
FLOWSTATE_MAX_SESSIONS=500
# Enables live AI recommendations. Never expose this key to the browser — it is only read by the server.
ANTHROPIC_API_KEY=
FLOWSTATE_AI_MODEL=claude-sonnet-5-5
FLOWSTATE_AI_TIMEOUT_MS=45000
